{
  "id": "tray",
  "name": "Tray",
  "version": "0.1.0",
  "author": "Josh <josh@example.com>",
  "description": "A collapsible system tray: pinned apps always show on the bar, the rest live behind a toggle.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 320
  },
  "files": [],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Tray"
  },
  "dependencies": {
    "commands": []
  },
  "metadata": {
    "settings": [
      {
        "key": "pinnedIds",
        "type": "text",
        "label": "Pinned tray icons (managed by the pin buttons in the panel; JSON id list)",
        "group": "Tray",
        "default": "[]"
      },
      {
        "key": "maxPinned",
        "type": "int",
        "label": "Max pinned icons shown on the bar",
        "group": "Tray",
        "default": 6,
        "min": 1,
        "max": 12
      }
    ]
  }
}
